# Kopier denne fila til .env.local og fyll inn verdiene. .env.local er gitignored.
# Start utviklingsserveren på nytt etter endringer.

# API-nøkkel til Anthropic, brukt når appen kjører i ekte modus.
# Hentes fra https://console.anthropic.com/. Lim inn nøkkelen uten anførselstegn.
# Bare serverkoden i src/server/ leser den, og den sendes aldri til nettleseren.
# Kan stå tom: demomodus virker uten nøkkel.
ANTHROPIC_API_KEY=
